# ==========================================
# AutoHaus Backend Environment Variables
# ==========================================

# Server Port (Render dynamically injects PORT; local default is 5000)
PORT=5000

# Environment mode ('development' | 'production')
NODE_ENV=development

# Database Connection (PostgreSQL)
# Local: postgresql://USER:PASSWORD@localhost:5432/car_dealership?schema=public
# Neon Production: postgresql://USER:PASSWORD@HOST.neon.tech/autohaus?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/car_dealership?schema=public"

# JWT Authentication
# In production, use a high-entropy 64-character random string
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin(s)
# Local: http://localhost:5173
# Production: https://autohaus-inventory.vercel.app (or comma-separated)
CLIENT_URL="http://localhost:5173"

# Optional Seed Credentials (Used only when running `npm run prisma:seed`)
# In production, pass via environment variables to never expose credentials
DEMO_ADMIN_EMAIL="admin@autohaus.com"
DEMO_ADMIN_PASSWORD="replace-with-secure-admin-password"
DEMO_USER_EMAIL="customer@autohaus.com"
DEMO_USER_PASSWORD="replace-with-secure-customer-password"
